{
  "name": "pi-model-recommend",
  "version": "1.0.0",
  "description": "Smart model recommendation and failover for Pi",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "lint": "npx eslint \"./**/*.{ts,js,mjs,cjs}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "npx prettier --check \"./**/*.{ts,js,json,md,yml,yaml}\"",
    "format:fix": "npx prettier --write \"./**/*.{ts,js,json,md,yml,yaml}\"",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "overrides": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@tempel/vitest": "^0.3.2",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
