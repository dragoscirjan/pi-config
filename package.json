{
  "name": "pi-config",
  "private": true,
  "workspaces": ["agent/extensions/pi-local-models", "agent/extensions/pi-model-recommend"],
  "prettier": {
    "bracketSpacing": true,
    "overrides": [
      {
        "files": "*.json",
        "options": {
          "parser": "json",
          "singleQuote": false
        }
      },
      {
        "files": "*.json5",
        "options": {
          "parser": "json5",
          "singleQuote": false
        }
      },
      {
        "files": "*.jsonc",
        "options": {
          "parser": "jsonc",
          "singleQuote": false
        }
      },
      {
        "files": "*.js",
        "options": {
          "parser": "babel"
        }
      },
      {
        "files": "*.md",
        "options": {
          "parser": "markdown",
          "singleQuote": false,
          "proseWrap": "preserve"
        }
      },
      {
        "files": ["*.yaml", "*.yml"],
        "options": {
          "parser": "yaml",
          "singleQuote": true,
          "bracketSpacing": true
        }
      }
    ],
    "parser": "typescript",
    "printWidth": 120,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "scripts": {
    "commitlint": "commitlint",
    "lint": "npx eslint \"agent/extensions/**/*.{ts,js,mjs,cjs}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "npx prettier --check \"agent/extensions/**/*.{ts,js,json,md,yml,yaml}\"",
    "format:fix": "npx prettier --write \"agent/extensions/**/*.{ts,js,json,md,yml,yaml}\"",
    "dupcheck": "npx jscpd --config .jscpd.json",
    "fallow:summary": "npx fallow --summary || true",
    "fallow:check": "npx fallow --summary --fail-on-issues",
    "fallow:audit": "npx fallow audit --base refactor",
    "fallow:dead-code": "npx fallow dead-code",
    "fallow:dupes": "npx fallow dupes",
    "fallow:health": "npx fallow health",
    "test": "npm run test --workspaces --if-present",
    "typecheck:strict": "npm run typecheck --workspaces --if-present",
    "typecheck": "npm run typecheck:strict || true",
    "quality": "npm run lint && npm run format && npm run dupcheck && npm run fallow:summary && npm run test && npm run typecheck",
    "quality:fix": "npm run lint:fix && npm run format:fix"
  },
  "overrides": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@eslint/js": "^9.39.5",
    "@jscpd/html-reporter": "^4.2.5",
    "@tempel/commitlint": "^1.1.0",
    "@tempel/vitest": "^0.3.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node-import": "^1.2.0",
    "fallow": "^3.34.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
